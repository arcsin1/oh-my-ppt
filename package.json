    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "win32"
      ],
      "cpu": [
        "current",
        "arm64",
        "x64"
      ]
    },
    "onlyBuiltDependencies": [
      "@google/genai",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "@langchain/core": "^1.1.47",
      "@langchain/langgraph": "^1.3.0"
    }
  }
